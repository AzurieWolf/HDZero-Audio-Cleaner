{
  "name": "hdzero-audio-cleaner",
  "productName": "HDZero Audio Cleaner",
  "version": "0.8.0",
  "description": "Batch channel removal and optional DeepFilterNet denoising for HDZero video recordings.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check editor_preload.js && node --check editor.js && node --check theme-bootstrap.js && node --check theme-controls.js && node --check file-organization.js",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win"
  },
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hdzero.audiocleaner",
    "productName": "HDZero Audio Cleaner",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "file-organization.js",
      "preload.js",
      "renderer.js",
      "editor_preload.js",
      "editor.js",
      "theme-bootstrap.js",
      "theme-controls.js",
      "index.html",
      "editor.html",
      "style.css",
      "editor.css",
      "theme.css",
      "favicon.ico",
      "package.json"
    ],
    "extraResources": [
      { "from": "dependencies/ffmpeg.exe", "to": "bin/ffmpeg.exe" },
      { "from": "dependencies/models/DeepFilterNet3", "to": "models/DeepFilterNet3" },
      { "from": "denoise_worker.py", "to": "denoise/denoise_worker.py" }
    ],
    "win": {
      "target": "dir",
      "executableName": "HDZero Audio Cleaner",
      "icon": "build/HDZero-Audio-Cleaner-Icon.ico"
    }
  }
}
